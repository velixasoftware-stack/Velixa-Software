# Production builds call the API server directly (Singapore, next to the
# Mumbai database) instead of through Netlify's /api proxy, which added ~0.7s
# to every request. Images and files under /uploads still go via the proxy
# (netlify.toml). Change this if the Render service URL changes.
VITE_API_BASE_URL=https://velixa-lims-sg.onrender.com/api
