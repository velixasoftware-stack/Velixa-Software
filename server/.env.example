PORT=4000

# PostgreSQL - local development (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hms_lims
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# PostgreSQL - Supabase / any managed Postgres (takes priority over DB_* above)
# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# DB_SSL=true

# Auth
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h

# Default Chief Admin (created by npm run seed)
CHIEF_ADMIN_USERNAME=chiefadmin
CHIEF_ADMIN_PASSWORD=ChangeMe@123

# Optional: makes every client's auto-created "chiefadmin" support login
# (see client.controller.js) share this one password instead of each
# getting its own random one. Leave blank to keep the random-per-client
# behavior.
SUPPORT_LOGIN_PASSWORD=

# Razorpay (leave blank to run in MOCK payment mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLIENT_URL=http://localhost:5173
